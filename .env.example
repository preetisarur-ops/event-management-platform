# ==================== REQUIRED ====================

# Neon PostgreSQL (get from https://console.neon.tech)
# Use the pooled connection string (ends with -pooler or includes ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth secret (generate a long random string, min 32 characters)
# Same value can be used for both AUTH_SECRET and NEXTAUTH_SECRET
NEXTAUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Your live app URL (no trailing slash) — required for auth redirects and QR links
NEXTAUTH_URL="https://your-project.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ==================== EMAIL (Resend) ====================

# Get from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender (must be verified in Resend dashboard)
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="GREEN FUTURE 2027"

# ==================== OPTIONAL ====================

# Vercel Blob for image uploads (Vercel Dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ==================== SETUP ONLY ====================
# Used once to protect the /setup page when creating the first Super Admin
SETUP_SECRET="temporary-setup-secret-change-me"
