# ==================== REQUIRED ====================

# Neon PostgreSQL (get from https://console.neon.tech)
# Use the pooled connection string for DATABASE_URL
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Non-pooled / direct connection (for migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js secret (generate a long random string)
# You can use: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public URL of your deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ==================== EMAIL (Resend) ====================

# Get from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender (must be verified in Resend dashboard)
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="GREEN FUTURE 2027"

# ==================== OPTIONAL BUT RECOMMENDED ====================

# Vercel Blob for image uploads (get from Vercel Dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ==================== SETUP ONLY ====================
# Used once to protect the /setup page when creating the first Super Admin
SETUP_SECRET="temporary-setup-secret-change-me"
